<odoo>
  <record id="view_field_domain_rule_form" model="ir.ui.view">
    <field name="name">field.domain.rule.form</field>
    <field name="model">field.domain.rule</field>
    <field name="arch" type="xml">
      <form string="Domain Rule">
        <sheet>
          <group>
            <field name="name"/>
            <field name="model_id"/>
            <field name="user_id"/>
            <field name="active"/>
          </group>
          <notebook>
                <page string="Conditions" name="Conditions">
                  <field name="rule_line_ids">
                    <tree editable="bottom">
                      <field name="field_name"/>
                      <field name="related_domain" invisible="1"/>
                      <field name="related_field_id"
                             domain="related_domain"
                             options="{'no_create': True}"/>
                      <field name="operator"/>
                      <field name="value" invisible="operator in ['set', 'not set']"/>
                    </tree>
                  </field>
                </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_field_domain_rule_tree" model="ir.ui.view">
    <field name="name">field.domain.rule.tree</field>
    <field name="model">field.domain.rule</field>
    <field name="arch" type="xml">
      <tree string="Domain Rules">
        <field name="name"/>
        <field name="model_id"/>
        <field name="user_id"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="action_field_domain_rules" model="ir.actions.act_window">
    <field name="name">Domain Rules</field>
    <field name="res_model">field.domain.rule</field>
    <field name="view_mode">tree,form</field>
  </record>


<!--  <menuitem id="menu_dynamic_domain_root" name="Dynamic Domains" sequence="10"/>-->
  <menuitem id="menu_field_domain_rules" name="Dynamic Domains"
             parent="base.next_id_2" action="action_field_domain_rules"/>

</odoo>
